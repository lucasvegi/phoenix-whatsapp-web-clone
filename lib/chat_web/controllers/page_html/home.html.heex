<div class="wa-container">

  <div class="wa-header">
    <div class="wa-avatar">INF</div>
    <div>
      <p class="wa-header-name">Chat INF321</p>
      <p class="wa-header-status">online</p>
    </div>
  </div>

  <ul id="messages"></ul>

  <form id="message-form">
    <input id="name-input"    type="text" placeholder="Seu nome..." />
    <input id="message-input" type="text" placeholder="Digite uma mensagem" />
    <button id="btn-submit" type="submit">
      <!-- ícone de envio no lugar do texto "Enviar" -->
      <svg viewBox="0 0 24 24" fill="white" width="20" height="20">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </form>

</div>
